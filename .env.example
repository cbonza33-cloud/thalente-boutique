# Copy this file to .env for local development (server.js reads process.env directly,
# so use your shell or a tool like `dotenv-cli`/Render's dashboard to set these).

# Required for real Yoco charges. Without it, checkout runs in safe "demo mode":
# orders are recorded and marked paid automatically with no real payment.
YOCO_SECRET_KEY=

# Admin dashboard PIN. Falls back to 1234 if unset — change this before going live.
ADMIN_PIN=1234

# Your deployed origin(s), comma-separated, for CORS (e.g. https://yourapp.onrender.com).
ALLOWED_ORIGIN=
ALLOWED_ORIGINS=

# Required for product image uploads. From your Supabase project settings
# (Project Settings → API). Use the service role key, not the anon key — it's
# used server-side only and is never exposed to the browser. Without both set,
# uploading a file returns a clear error; pasting an external image URL still
# works either way.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Render sets this automatically; only needed for local testing on a custom port.
PORT=5000
